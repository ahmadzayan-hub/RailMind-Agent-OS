# RailMind Agent OS configuration. Read by src/config.ts.
# Every variable is optional. With none set, the server runs the synthetic in-memory demo.
# Never commit real values. Copy to .env locally if you need overrides.

# HTTP port (default 4173; Replit uses 5000)
PORT=4173

# demo (default, synthetic provider) or production (refuses to start without live adapters)
RAILMIND_MODE=demo

# PostgreSQL connection string. Empty means in-memory state that resets on restart.
DATABASE_URL=

# synthetic (default), internal or confidential. Controls model invocation policy.
DATA_CLASSIFICATION=synthetic

# JSON array of { principalId, displayName, role, scopes, tokenSha256 }. Empty means demo tokens.
# Generate a hash with: node --experimental-strip-types scripts/hash-token.mjs <token>
RAILMIND_USERS=

# Optional OpenAI-compatible model gateway (local by default)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_REMOTE_APPROVED_FOR_INTERNAL=false
LLM_REMOTE_APPROVED_FOR_CONFIDENTIAL=false

# Optional read-only Maximo REST client. Empty means the in-memory mock port.
MAXIMO_BASE_URL=
MAXIMO_API_KEY=
MAXIMO_OS_ASSETS=MXAPIASSET
MAXIMO_OS_WORKORDERS=MXAPIWODETAIL
MAXIMO_OS_PM=MXAPIPM
MAXIMO_OS_METERS=MXAPIMETER
MAXIMO_OS_INVOICES=MXAPIINVOICE
